# ==============================================================================
# PatientCare PMS - Environment Configuration Template
# Strictly do NOT commit real secrets (.env) to version control (/cso compliance)
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Security & JWT Tokens (/cso standard)
# Generate a strong 256-bit random secret in production (e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=your-random-256-bit-secret-key-change-this-in-production
JWT_EXPIRES_IN=24h

# Administrator Master Authentication
# Required to access /admin portal securely without hardcoded credentials
ADMIN_EMAIL=admin@yourclinic.org
ADMIN_USERNAME=admin
ADMIN_PASSWORD="your-secure-admin-passkey-here"

# Initial Doctor Setup (Optional, used during database seeding)
INITIAL_DOCTOR_EMAIL=doctor@yourclinic.org
INITIAL_DOCTOR_USERNAME=doctor
INITIAL_DOCTOR_PASSWORD="your-initial-doctor-password-here"

# Supabase (PostgreSQL) Configuration
# Found in Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Client Vite Configuration
VITE_API_URL=http://localhost:5000/api
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
